.wrangler/
__pycache__/
*.pyc

# Per-developer signing override (see Signing.xcconfig) — each dev's own DEVELOPMENT_TEAM.
Signing.local.xcconfig

# Local agent instructions
[Aa][Gg][Ee][Nn][Tt][Ss].[Mm][Dd]
[Cc][Ll][Aa][Uu][Dd][Ee].[Mm][Dd]
.claude/.edited-*

# Claude Code: per-user settings
.claude/settings.local.json

# Present while scripts/promises.sh plants bugs
.promises-running
