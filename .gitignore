# macOS
.DS_Store

# Xcode — per-user state (never commit; machine-specific noise)
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# Xcode / build output
DerivedData/
build/
*.moved-aside
*.hmap
*.ipa
*.dSYM
*.dSYM.zip

# Swift Package Manager
.build/
.swiftpm/
# (Package.resolved is deliberately COMMITTED — everyone resolves identical deps.)



