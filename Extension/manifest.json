{
  "manifest_version": 3,
  "name": "Workbench pages",
  "version": "0.3.0",
  "description": "Sends the text you see on a page, the Gmail threads you open inside the label you named, and the WhatsApp Web chats you allowed, to Workbench on this Mac. Workbench keeps them only when its switches are on.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "https://mail.google.com/*",
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "mail/selectors.js",
        "mail/reader.js",
        "mail/deck.js",
        "mail/watch.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "whatsapp/reader.js",
        "whatsapp/watch.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "incognito": "not_allowed"
}
