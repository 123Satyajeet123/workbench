{
  "manifest_version": 3,
  "name": "Workbench pages",
  "version": "0.1.0",
  "description": "Sends the text you see on a page to Workbench on this Mac. Workbench keeps it only when Screen text is on and the site is not private.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "incognito": "not_allowed"
}
